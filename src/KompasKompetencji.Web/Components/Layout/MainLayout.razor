@inherits LayoutComponentBase
@inject NavigationManager Navigation

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween" class="app-header">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
                <RadzenIcon Icon="explore" IconColor="@Colors.Primary" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0 rz-ms-2">Kompas kompetencji</RadzenText>
            </RadzenStack>

            <AuthorizeView>
                <Authorized>
                    <RadzenProfileMenu Click="@OnProfileMenuClick">
                        <Template>
                            <UserAvatar Name="@context.User.Identity?.Name" />
                        </Template>
                        <ChildContent>
                            <RadzenProfileMenuItem Text="Wyloguj" Value="@LogoutValue" Icon="logout" />
                        </ChildContent>
                    </RadzenProfileMenu>
                </Authorized>
            </AuthorizeView>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="sidebarExpanded">
        <AuthorizeView>
            <Authorized>
                <RadzenStack JustifyContent="JustifyContent.SpaceBetween" class="app-sidebar">
                    <RadzenStack Gap="1rem">
                        @foreach (var group in RoleNavigation.For(context.User.GetRole()))
                        {
                            <RadzenStack Gap="0.25rem">
                                <RadzenText TextStyle="TextStyle.Overline" class="nav-group-label rz-color-base-300">@group.Title</RadzenText>
                                <RadzenPanelMenu>
                                    @foreach (var item in group.Items)
                                    {
                                        <RadzenPanelMenuItem Text="@item.Text" Path="@item.Path" Icon="@item.Icon" />
                                    }
                                </RadzenPanelMenu>
                            </RadzenStack>
                        }
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" class="sidebar-user">
                        <UserAvatar Name="@context.User.Identity?.Name" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@context.User.Identity?.Name</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-base-300">@AppRoles.DisplayName(context.User.GetRole())</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenStack>
            </Authorized>
        </AuthorizeView>
    </RadzenSidebar>

    <RadzenBody>
        <div class="app-content">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

<AuthorizeView>
    <Authorized>
        <AssistantChat />
    </Authorized>
</AuthorizeView>

<RadzenComponents />

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string LogoutValue = "logout";

    private bool sidebarExpanded = true;

    private void OnProfileMenuClick(RadzenProfileMenuItem item)
    {
        if (item.Value == LogoutValue)
        {
            Navigation.NavigateTo(AuthEndpoints.LogoutPath, forceLoad: true);
        }
    }
}
