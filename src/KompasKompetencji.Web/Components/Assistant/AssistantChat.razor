<div class="assistant-window @(open ? "is-open" : "")" role="dialog" aria-label="Asystent Formalny" aria-hidden="@(open ? "false" : "true")">
    <RadzenCard Variant="Variant.Outlined" class="assistant-card rz-p-0 rz-shadow-6">
        <RadzenAIChat @ref="chat" Title="Asystent Formalny" Placeholder="Zapytaj o przepisy, terminy albo procedurę oceny…"
                      SystemPrompt="@SystemPrompt" ShowClearButton="true" ShowAvatars="false" AllowHtml="false"
                      ShowDateSeparator="false" class="assistant-chat"
                      ChatCleared="@ShowGreeting">
            <CitationTemplate Context="citation">
                <span class="rz-chat-citation" title="@citation.Snippet">
                    <span class="rz-chat-citation-index">@citation.FileId</span>
                    <span class="rz-chat-citation-title">@citation.Title</span>
                </span>
            </CitationTemplate>
        </RadzenAIChat>
    </RadzenCard>
</div>

<RadzenButton Icon="@(open ? "close" : "smart_toy")" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
              class="assistant-bubble rz-shadow-6" title="@(open ? "Zamknij asystenta" : "Zapytaj o przepisy")"
              aria-expanded="@(open ? "true" : "false")" Click="@(() => open = !open)" />
