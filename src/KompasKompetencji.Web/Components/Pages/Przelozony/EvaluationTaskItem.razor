@inject NavigationManager Navigation

<RadzenCard Variant="Variant.Filled" class="rz-p-3">
    <RadzenStack Gap="0.75rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenStack Gap="0.25rem" class="card-heading">
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0 rz-text-truncate">
                    <RadzenLink Path="@EmployeeEvaluation.PathFor(Task.Employee.Id)" Text="@Task.Employee.FullName" />
                </RadzenText>
                @if (Task.Urgency == EvaluationUrgency.Overdue)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" IsPill="true" Text="Po terminie" class="align-self-start" />
                }
            </RadzenStack>

            <RadzenStack Gap="0" AlignItems="AlignItems.End" class="no-shrink">
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@EvaluationText.Date(Task.DueDate)</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="@(OverdueDays > 0 ? "rz-m-0 rz-color-danger text-small" : "rz-m-0 rz-color-base-500 text-small")">@EvaluationText.RelativeToToday(Task.DueDate, Today)</RadzenText>
            </RadzenStack>
        </RadzenStack>

        @if (ConversationPastDue && Task.ConversationAt is DateTime pastConversationAt)
        {
            <RadzenStack Gap="0.5rem" class="conversation-row">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="min-w-0">
                    <RadzenIcon Icon="warning" IconColor="@Colors.Warning" class="no-shrink" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                        Rozmowa @EvaluationText.Date(pastConversationAt): termin minął
                    </RadzenText>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="Zmień termin" Icon="edit_calendar" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                  Click="@(() => OnConversation.InvokeAsync(Task))" />
                    <RadzenButton Text="Oznacz jako odbytą" Icon="task_alt" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                  Click="@(() => OnMarkHeld.InvokeAsync(Task))" />
                </RadzenStack>
            </RadzenStack>
        }
        else if (Task.NeedsSheet)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween"
                         Gap="0.75rem" class="conversation-row">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="min-w-0">
                    <RadzenIcon Icon="assignment_late" IconColor="@Colors.Warning" class="no-shrink" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">Przed wyznaczeniem rozmowy zatwierdź arkusz</RadzenText>
                </RadzenStack>
                <RadzenButton Text="Zatwierdź arkusz" Icon="assignment" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                              class="no-shrink" Click="@(() => Navigation.NavigateTo(EmployeeEvaluation.PathFor(Task.Employee.Id)))" />
            </RadzenStack>
        }
        else if (Task.NeedsConversation)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween"
                         Gap="0.75rem" class="conversation-row">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="min-w-0">
                    <RadzenIcon Icon="event_busy" IconColor="@Colors.Warning" class="no-shrink" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                        @(Task.Urgency == EvaluationUrgency.Overdue
                            ? "Wyznacz termin rozmowy jak najszybciej"
                            : $"Wyznacz termin rozmowy, najpóźniej {EvaluationText.Date(Task.DueDate)}")
                    </RadzenText>
                </RadzenStack>
                <RadzenButton Text="Wyznacz termin" Icon="edit_calendar" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                              class="no-shrink" Click="@(() => OnConversation.InvokeAsync(Task))" />
            </RadzenStack>
        }
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public EvaluationTask Task { get; set; } = default!;

    [Parameter, EditorRequired] public DateOnly Today { get; set; }

    [Parameter] public bool ConversationPastDue { get; set; }

    [Parameter] public EventCallback<EvaluationTask> OnConversation { get; set; }

    [Parameter] public EventCallback<EvaluationTask> OnMarkHeld { get; set; }

    private int OverdueDays => Today.DayNumber - Task.DueDate.DayNumber;
}
