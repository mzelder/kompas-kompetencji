@page "/przelozony/pracownicy"

<PageTitle>Moi pracownicy – Kompas kompetencji</PageTitle>

<div class="fill-page">
    <PageHeader Title="Moi pracownicy"
                Subtitle="Twoi podwładni objęci oceną okresową." />

    @if (loadError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
            Nie udało się wczytać danych: @loadError
        </RadzenAlert>
    }

    @if (accountNotLinked)
    {
        <StatusMessage Icon="link_off" IconColor="@Colors.Warning" Title="Konto nie jest powiązane z pracownikiem"
                       Text="Poproś HR o powiązanie Twojego konta z kartą pracownika, aby zobaczyć swój zespół." />
    }
    else
    {
        <EmployeeStageList Employees="@employees" Stages="@stages" Loading="@loading"
                           CountLabel="Podwładni" EmptyText="Nie masz jeszcze podwładnych."
                           OnEmployeeClick="@OpenEmployee">
            <StageDetails Context="employee">
                @if (AssessmentTaskFor(employee) is EvaluationTask task)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween"
                                 Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="min-w-0">
                            @if (task.ConversationAt is DateTime conversationAt)
                            {
                                <RadzenIcon Icon="event" IconColor="@Colors.Primary" class="no-shrink" />
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                                    Rozmowa oceniająca @EvaluationText.Date(conversationAt)
                                </RadzenText>
                            }
                            else if (task.CanScheduleConversation)
                            {
                                <RadzenIcon Icon="event_available" IconColor="@Colors.Primary" class="no-shrink" />
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                                    Możesz wyznaczyć rozmowę oceniającą, najpóźniej @EvaluationText.Date(task.DueDate)
                                </RadzenText>
                            }
                            else
                            {
                                <RadzenIcon Icon="schedule" class="no-shrink rz-color-base-300" />
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-base-300">
                                    Rozmowę oceniającą wyznaczysz od @EvaluationText.Date(task.ConversationWindowOpensOn)
                                </RadzenText>
                            }
                        </RadzenStack>
                        @if (task.NeedsConversation)
                        {
                            <div @onclick:stopPropagation="true" class="no-shrink">
                                <RadzenButton Text="Wyznacz termin" Icon="edit_calendar" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                              Click="@(() => ScheduleConversationAsync(task))" />
                            </div>
                        }
                    </RadzenStack>
                }
            </StageDetails>
        </EmployeeStageList>
    }
</div>
