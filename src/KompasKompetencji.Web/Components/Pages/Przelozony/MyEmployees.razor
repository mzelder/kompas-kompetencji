@page "/przelozony/pracownicy"
@inject OrganizationService Organization
@inject UserService Users
@inject EvaluationService Evaluations
@inject NavigationManager Navigation

<PageTitle>Moi pracownicy – Kompas kompetencji</PageTitle>

<div class="fill-page">
    <PageHeader Title="Moi pracownicy"
                Subtitle="Twoi podwładni objęci oceną okresową." />

    @if (loadError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
            Nie udało się wczytać danych: @loadError
        </RadzenAlert>
    }

    @if (accountNotLinked)
    {
        <StatusMessage Icon="link_off" IconColor="@Colors.Warning" Title="Konto nie jest powiązane z pracownikiem"
                       Text="Poproś HR o powiązanie Twojego konta z kartą pracownika, aby zobaczyć swój zespół." />
    }
    else
    {
        <EmployeeStageList Employees="@employees" Stages="@stages" Loading="@loading"
                           CountLabel="Podwładni" EmptyText="Nie masz jeszcze podwładnych."
                           OnEmployeeClick="@OpenEmployee" />
    }
</div>

@code {
    private IReadOnlyList<Employee> employees = [];
    private IReadOnlyDictionary<int, EvaluationStage> stages = new Dictionary<int, EvaluationStage>();
    private bool loading = true;
    private bool accountNotLinked;
    private string? loadError;

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userId = (await AuthState).User.GetUserId();
            var user = userId is null ? null : await Users.GetByIdAsync(userId.Value);
            if (user?.EmployeeId is int supervisorId)
            {
                employees = (await Organization.GetChartAsync()).SubordinatesOf(supervisorId);
                stages = await Evaluations.GetCurrentStagesAsync(employees.Select(e => e.Id).ToList());
            }
            else
            {
                accountNotLinked = true;
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        loading = false;
    }

    private void OpenEmployee(Employee employee) =>
        Navigation.NavigateTo(EmployeeEvaluation.PathFor(employee.Id));
}
