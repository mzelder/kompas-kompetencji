@page "/przelozony/pracownicy"

<PageTitle>Moi pracownicy – Kompas kompetencji</PageTitle>

<div class="fill-page">
    <PageHeader Title="Moi pracownicy"
                Subtitle="Twoi podwładni objęci oceną okresową." />

    @if (loadError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
            Nie udało się wczytać danych: @loadError
        </RadzenAlert>
    }

    @if (accountNotLinked)
    {
        <StatusMessage Icon="link_off" IconColor="@Colors.Warning" Title="Konto nie jest powiązane z pracownikiem"
                       Text="Poproś HR o powiązanie Twojego konta z kartą pracownika, aby zobaczyć swój zespół." />
    }
    else
    {
        <EmployeeStageList Rows="@rows" Today="@today" Loading="@loading"
                           CountLabel="Podwładni" EmptyText="Nie masz jeszcze podwładnych."
                           OnEmployeeClick="@OpenEmployee">
            <NextStep Context="row">
                @if (NextStepFor(row) is NextStepView step)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem">
                        <RadzenStack Gap="0" class="min-w-0">
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0 rz-text-truncate">@step.Title</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="@(step.IsWarning ? "rz-m-0 rz-color-warning rz-text-truncate" : "rz-m-0 rz-color-base-300 rz-text-truncate")">
                                @step.Detail
                            </RadzenText>
                        </RadzenStack>
                        @if (step.Action is NextStepAction action)
                        {
                            <div @onclick:stopPropagation="true" class="no-shrink">
                                <RadzenButton Text="@action.Text" Icon="@action.Icon" ButtonStyle="@action.Style" Variant="@action.Variant"
                                              Size="ButtonSize.Small" Disabled="@(!action.Enabled)" Click="@(() => RunActionAsync(row))" />
                            </div>
                        }
                    </RadzenStack>
                }
            </NextStep>
        </EmployeeStageList>
    }
</div>
