<RadzenStack Gap="1.25rem">
    <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Wrap="FlexWrap.Wrap">
        <DetailItem Label="Pracownik" Value="@Task.Employee.FullName" />
        <DetailItem Label="@DeadlineLabel" Value="@($"{EvaluationText.Date(deadline)} ({EvaluationText.RelativeToToday(deadline, Today)})")" />
    </RadzenStack>

    @if (ConversationRules.IsPastDue(currentAt, currentStatus, DateTime.Now))
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">
            Termin rozmowy minął @EvaluationText.Date(currentAt!.Value). Oznacz ją jako odbytą albo wyznacz nowy termin.
        </RadzenAlert>
    }
    else if (overdue)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">
            @OverdueMessage
        </RadzenAlert>
    }

    <RadzenFormField Text="Data i godzina rozmowy" Variant="Variant.Outlined" class="rz-w-100">
        <ChildContent>
            <RadzenDatePicker TValue="DateTime" Name="ConversationAt" Value="@conversationAt" ValueChanged="@OnDateChanged"
                              ShowTime="true" HourFormat="24" MinutesStep="15" DateFormat="dd.MM.yyyy HH:mm"
                              Max="@latestAllowed" />
        </ChildContent>
        <Helper>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-base-300">
                @DateHint
            </RadzenText>
        </Helper>
    </RadzenFormField>

    <RadzenStack Gap="0.5rem">
        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-base-300">Status rozmowy</RadzenText>
        <RadzenRadioButtonList TValue="ConversationStatus" @bind-Value="status" Orientation="Orientation.Vertical" Gap="0.5rem">
            <Items>
                <RadzenRadioButtonListItem TValue="ConversationStatus" Value="ConversationStatus.Scheduled"
                                           Text="@EvaluationText.Conversation(ConversationStatus.Scheduled)"
                                           Disabled="@(!ConversationRules.CanBeScheduled(conversationAt, currentAt, DateTime.Now))" />
                <RadzenRadioButtonListItem TValue="ConversationStatus" Value="ConversationStatus.Held"
                                           Text="@EvaluationText.Conversation(ConversationStatus.Held)"
                                           Disabled="@(!ConversationRules.CanBeHeld(conversationAt, DateTime.Now))" />
            </Items>
        </RadzenRadioButtonList>
        @if (StatusHint is not null)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-base-300">@StatusHint</RadzenText>
        }
    </RadzenStack>

    @if (errorMessage is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">
            @errorMessage
        </RadzenAlert>
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="Anuluj" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Disabled="@busy"
                      Click="@(() => DialogService.Close(false))" />
        <RadzenButton Text="Zapisz" Icon="event_available" ButtonStyle="ButtonStyle.Primary"
                      IsBusy="@busy" BusyText="Zapisywanie…" Click="@SaveAsync" />
    </RadzenStack>
</RadzenStack>
