@page "/Error"

<PageTitle>Błąd – Kompas kompetencji</PageTitle>

<StatusMessage Icon="error" IconColor="@Colors.Danger" Title="Wystąpił błąd"
               Text="Nie udało się przetworzyć żądania. Spróbuj ponownie.">
    @if (ShowRequestId)
    {
        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">Identyfikator żądania: @RequestId</RadzenText>
    }
    <RadzenButton Text="Wróć do swojego panelu" Icon="home" Path="/" ButtonStyle="ButtonStyle.Primary" />
</StatusMessage>
