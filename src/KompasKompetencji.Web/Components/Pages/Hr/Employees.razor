@page "/hr/pracownicy"

<PageTitle>Pracownicy i przełożeni – Kompas kompetencji</PageTitle>

<div class="fill-page">
    <PageHeader Title="Pracownicy i przełożeni"
                Subtitle="Wybierz pracownika, aby zobaczyć tylko jego przełożonych. Kliknij go ponownie, aby odznaczyć." />

    @if (loadError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
            Nie udało się wczytać danych: @loadError
        </RadzenAlert>
    }

    <RadzenRow Gap="1.5rem" class="fill-row">
        <RadzenColumn Size="12" SizeMD="6" class="fill-column">
            <RadzenCard Variant="Variant.Outlined" class="fill-card">
                <RadzenStack Gap="1rem" class="fill-stack">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0" class="card-heading">
                            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0">Pracownicy</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-base-300 rz-text-truncate">
                                @CountCaption(filteredEmployees.Count, chart.Employees.Count, "Wszyscy pracownicy")
                            </RadzenText>
                        </RadzenStack>
                        <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="no-shrink"
                                      title="Dodaj pracownika" aria-label="Dodaj pracownika" Click="@AddEmployeeAsync" />
                    </RadzenStack>

                    <SearchBox Value="@employeeSearch" ValueChanged="@OnEmployeeSearchChanged"
                               Placeholder="Szukaj: nazwisko, stanowisko, komórka" />

                    <RadzenDataGrid TItem="Employee" Data="@filteredEmployees" @bind-Value="employeeSelection" IsLoading="@loading"
                                    SelectionMode="DataGridSelectionMode.Single" RowClick="@OnEmployeeRowClick" RowSelect="@OnEmployeeSelect" RowDeselect="@OnEmployeeDeselect"
                                    AllowSorting="true"
                                    EmptyText="@(string.IsNullOrWhiteSpace(employeeSearch) ? "Brak pracowników." : "Nikt nie pasuje do wyszukiwania.")"
                                    class="person-grid fill-grid">
                        <Columns>
                            <RadzenDataGridColumn Property="@nameof(Employee.FullName)" Title="Imię i nazwisko">
                                <Template Context="employee">
                                    <PersonName Person="@employee" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="@nameof(Employee.Position)" Title="Stanowisko" />
                        </Columns>
                    </RadzenDataGrid>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6" class="fill-column">
            <RadzenCard Variant="Variant.Outlined" class="fill-card">
                <RadzenStack Gap="1rem" class="fill-stack">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenStack Gap="0" class="card-heading">
                            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0">Przełożeni</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-base-300 rz-text-truncate">
                                @(selectedEmployee is null
                                    ? CountCaption(filteredSupervisors.Count, visibleSupervisors.Count, "Wszyscy przełożeni")
                                    : $"Przełożeni pracownika: {selectedEmployee.FullName}")
                            </RadzenText>
                        </RadzenStack>
                        <RadzenButton Text="Dodaj przełożonego" Icon="person_add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="no-shrink"
                                      Disabled="@(selectedEmployee is null)"
                                      title="@(selectedEmployee is null ? "Najpierw wybierz pracownika" : null)"
                                      Click="@AssignSupervisorAsync" />
                    </RadzenStack>

                    <SearchBox Value="@supervisorSearch" ValueChanged="@OnSupervisorSearchChanged"
                               Placeholder="Szukaj: nazwisko, stanowisko, komórka" />

                    <RadzenDataGrid TItem="Employee" Data="@filteredSupervisors" @bind-Value="supervisorSelection" IsLoading="@loading"
                                    SelectionMode="DataGridSelectionMode.Single" RowClick="@OnSupervisorRowClick" RowSelect="@OnSupervisorSelect" RowDeselect="@OnSupervisorDeselect"
                                    AllowSorting="true"
                                    EmptyText="@SupervisorsEmptyText"
                                    class="person-grid fill-grid">
                        <Columns>
                            <RadzenDataGridColumn Property="@nameof(Employee.FullName)" Title="Imię i nazwisko">
                                <Template Context="supervisor">
                                    <PersonName Person="@supervisor" ShowSupervisorIcon="false" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="@nameof(Employee.Position)" Title="Stanowisko" />
                            <RadzenDataGridColumn Title="" Width="64px" Sortable="false" TextAlign="TextAlign.Center"
                                                  Visible="@(selectedEmployee is not null)">
                                <Template Context="supervisor">
                                    <span @onclick:stopPropagation="true">
                                        <RadzenButton Icon="link_off" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                      title="Usuń przypisanie" aria-label="Usuń przypisanie"
                                                      Click="@(() => RemoveSupervisorAsync(supervisor))" />
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Variant="Variant.Outlined" class="details-card rz-mt-6">
        @if (FocusedPerson is null)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenIcon Icon="info" />
                <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0 rz-color-base-300">
                    Zaznacz pracownika albo przełożonego, aby zobaczyć szczegóły.
                </RadzenText>
            </RadzenStack>
        }
        else
        {
            <PersonDetails Person="@FocusedPerson" Chart="@chart" />
        }
    </RadzenCard>
</div>
