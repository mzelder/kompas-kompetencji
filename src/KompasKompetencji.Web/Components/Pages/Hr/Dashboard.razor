@page "/hr"

<PageTitle>Procesy ocen – Kompas kompetencji</PageTitle>

<PageHeader Title="Procesy ocen"
            Subtitle="Statusy i terminy ocen okresowych w urzędzie." />

<RadzenDataGrid Data="@processes" TItem="EvaluationProcessRow" EmptyText="Brak rozpoczętych procesów ocen."
                AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple">
    <Columns>
        <RadzenDataGridColumn Property="@nameof(EvaluationProcessRow.Employee)" Title="Pracownik" />
        <RadzenDataGridColumn Property="@nameof(EvaluationProcessRow.Supervisor)" Title="Przełożony" />
        <RadzenDataGridColumn Property="@nameof(EvaluationProcessRow.Sheet)" Title="Arkusz" />
        <RadzenDataGridColumn Property="@nameof(EvaluationProcessRow.Status)" Title="Status" />
        <RadzenDataGridColumn Property="@nameof(EvaluationProcessRow.Deadline)" Title="Termin" FormatString="{0:yyyy-MM-dd}" />
    </Columns>
</RadzenDataGrid>
