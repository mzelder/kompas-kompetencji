<RadzenTemplateForm TItem="EmployeeForm" Data="@form" Submit="@SaveAsync">
    <RadzenStack Gap="1rem">
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenFormField Text="Imię" Variant="Variant.Outlined" class="rz-w-100">
                    <ChildContent>
                        <RadzenTextBox Name="FirstName" @bind-Value="form.FirstName" MaxLength="100" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="FirstName" Text="Podaj imię." />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeSM="6">
                <RadzenFormField Text="Nazwisko" Variant="Variant.Outlined" class="rz-w-100">
                    <ChildContent>
                        <RadzenTextBox Name="LastName" @bind-Value="form.LastName" MaxLength="100" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="LastName" Text="Podaj nazwisko." />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenFormField Text="Stanowisko pracy" Variant="Variant.Outlined" class="rz-w-100">
            <ChildContent>
                <RadzenDropDown TValue="int?" Name="JobPosition" @bind-Value="form.JobPositionId" Data="@positions"
                                ValueProperty="Id" TextProperty="Label" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains"
                                Placeholder="Wybierz stanowisko z opisu stanowiska pracy" PopupStyle="max-height: 22rem;">
                    <Template Context="item">
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0">@(((PositionItem)item).Label)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-base-300">@(((PositionItem)item).Details)</RadzenText>
                        </RadzenStack>
                    </Template>
                </RadzenDropDown>
            </ChildContent>
            <Helper>
                <RadzenRequiredValidator Component="JobPosition" Text="Wybierz stanowisko pracy." />
            </Helper>
        </RadzenFormField>

        @if (SelectedPosition is PositionItem selected)
        {
            <RadzenCard Variant="Variant.Filled" class="rz-p-3">
                <RadzenStack Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@selected.Position.Purpose</RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Wrap="FlexWrap.Wrap">
                        <DetailItem Label="Komórka organizacyjna" Value="@selected.Position.OrganizationalUnit" />
                        <DetailItem Label="Podlegli pracownicy" Value="@EvaluationText.Subordinates(selected.Position.Subordinates)" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-base-300">
                        @(selected.Position.ManagesTeam
                            ? "Stanowisko kieruje zespołem, więc pracownik będzie mógł być przełożonym."
                            : "Stanowisko nie kieruje zespołem.")
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        }

        <RadzenFormField Text="Data zatrudnienia" Variant="Variant.Outlined" class="rz-w-100">
            <ChildContent>
                <RadzenDatePicker TValue="DateTime" Name="EmployedSince" @bind-Value="form.EmployedSince" DateFormat="dd.MM.yyyy" />
            </ChildContent>
            <Helper>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-base-300">
                    Pierwsza ocena okresowa: @EvaluationText.Date(EvaluationSchedule.NextDueDate(DateOnly.FromDateTime(form.EmployedSince)))
                </RadzenText>
            </Helper>
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Anuluj" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Disabled="@busy"
                          Click="@(() => DialogService.Close(null))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Dodaj pracownika" Icon="person_add"
                          ButtonStyle="ButtonStyle.Primary" IsBusy="@busy" BusyText="Zapisywanie…" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>
