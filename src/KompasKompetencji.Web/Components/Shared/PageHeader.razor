<RadzenStack Gap="0.25rem" class="rz-mb-6">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">@Title</RadzenText>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0 rz-color-base-300">@Subtitle</RadzenText>
    }
</RadzenStack>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Subtitle { get; set; }
}
