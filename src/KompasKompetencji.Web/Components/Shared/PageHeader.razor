<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" class="@(Compact ? "rz-mb-3" : "rz-mb-6")">
    <RadzenStack Gap="0.25rem" class="min-w-0">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">@Title</RadzenText>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0 rz-color-base-300">@Subtitle</RadzenText>
        }
    </RadzenStack>
    @if (ChildContent is not null)
    {
        <div class="no-shrink">@ChildContent</div>
    }
</RadzenStack>
