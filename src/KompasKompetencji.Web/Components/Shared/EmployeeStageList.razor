<RadzenCard Variant="Variant.Outlined" class="fill-card fill-row">
    <RadzenStack Gap="1rem" class="fill-stack">
        <RadzenStack Gap="0">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0">Pracownicy</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-base-300 rz-text-truncate">
                @CountCaption
            </RadzenText>
        </RadzenStack>

        <SearchBox Value="@search" ValueChanged="@OnSearchChanged"
                   Placeholder="Szukaj: nazwisko, komórka" />

        <RadzenDataGrid TItem="Employee" Data="@filteredEmployees" IsLoading="@Loading"
                        AllowSorting="true" RowClick="@OnRowClick" class="person-grid fill-grid"
                        EmptyText="@(string.IsNullOrWhiteSpace(search) ? EmptyText : "Nikt nie pasuje do wyszukiwania.")">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(Employee.FullName)" Title="Imię i nazwisko" Width="320px">
                    <Template Context="employee">
                        <PersonName Person="@employee" ShowSupervisorIcon="false" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Etap oceny" Sortable="false">
                    <Template Context="employee">
                        <EvaluationStageText Stage="@(Stages.TryGetValue(employee.Id, out var stage) ? stage : null)" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenStack>
</RadzenCard>

@code {
    private IReadOnlyList<Employee> filteredEmployees = [];
    private string? search;

    [Parameter, EditorRequired] public IReadOnlyList<Employee> Employees { get; set; } = [];

    [Parameter, EditorRequired] public IReadOnlyDictionary<int, EvaluationStage> Stages { get; set; } = default!;

    [Parameter] public bool Loading { get; set; }

    [Parameter] public string CountLabel { get; set; } = "Pracownicy";

    [Parameter] public string EmptyText { get; set; } = "Brak pracowników.";

    [Parameter] public EventCallback<Employee> OnEmployeeClick { get; set; }

    private string CountCaption => filteredEmployees.Count == Employees.Count
        ? $"{CountLabel}: {Employees.Count}"
        : $"Wyniki wyszukiwania: {filteredEmployees.Count} z {Employees.Count}";

    protected override void OnParametersSet()
    {
        filteredEmployees = EmployeeSearch.Filter(Employees, search);
    }

    private async Task OnRowClick(DataGridRowMouseEventArgs<Employee> args)
    {
        if (args.Data is Employee employee)
        {
            await OnEmployeeClick.InvokeAsync(employee);
        }
    }

    private void OnSearchChanged(string value)
    {
        search = value;
        filteredEmployees = EmployeeSearch.Filter(Employees, search);
    }
}
