<RadzenCard Variant="Variant.Outlined" class="fill-card fill-row">
    <RadzenStack Gap="1rem" class="fill-stack">
        <RadzenStack Gap="0">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0">Pracownicy</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-base-300 rz-text-truncate">
                @CountCaption
            </RadzenText>
        </RadzenStack>

        <StageLegend />

        <SearchBox Value="@search" ValueChanged="@OnSearchChanged"
                   Placeholder="Szukaj: nazwisko, komórka" />

        <RadzenDataGrid TItem="EmployeeEvaluationRow" Data="@filteredRows" IsLoading="@Loading"
                        AllowSorting="true" RowClick="@OnRowClick" class="person-grid fill-grid"
                        EmptyText="@(string.IsNullOrWhiteSpace(search) ? EmptyText : "Nikt nie pasuje do wyszukiwania.")">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(EmployeeEvaluationRow.FullName)" Title="Imię i nazwisko" Width="280px">
                    <Template Context="row">
                        <PersonName Person="@row.Employee" ShowSupervisorIcon="false" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(EmployeeEvaluationRow.Stage)" Title="Etap oceny" Width="240px">
                    <Template Context="row">
                        <StageMarker Stage="@row.Stage" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(EmployeeEvaluationRow.DueDate)" Title="Termin oceny" Width="180px">
                    <Template Context="row">
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@EvaluationText.Date(row.DueDate)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="@(row.DueDate < Today ? "rz-m-0 rz-color-danger text-small" : "rz-m-0 rz-color-base-500 text-small")">
                                @EvaluationText.RelativeToToday(row.DueDate, Today)
                            </RadzenText>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                @if (NextStep is not null)
                {
                    <RadzenDataGridColumn Title="Następny krok" Sortable="false">
                        <Template Context="row">
                            @NextStep(row)
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    </RadzenStack>
</RadzenCard>
